// Cloudflare Workers config for Hunnyhive (static site + routing worker)
{
  "name": "hunnyhive",
  "main": "_worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // the worker sees every request first (subdomains, /apps/<slug>, redirects, headers)
    "run_worker_first": true
  }
  // Storage for MasterDash, submissions and uploads. Paste the KV namespace ID below, then remove the // marks:
  // ,"kv_namespaces": [{ "binding": "HIVE", "id": "PASTE_KV_NAMESPACE_ID_HERE" }]
}
